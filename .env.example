# ==============================================================================
# Environment Configuration — Food Ordering Platform (Cd: Zaika)
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
NODE_ENV=development

# Database Configuration (MongoDB)
# If running MongoDB locally, use: mongodb://127.0.0.1:27017/food_ordering_platform
# Or a MongoDB Atlas connection string:
MONGODB_URI=mongodb://127.0.0.1:27017/food_ordering_platform

# Artificial Intelligence Integrations
# OpenAI API Key (used for conversational discovery, smart dietary advisor, and recommendations)
OPENAI_API_KEY=

# Google Generative AI (Gemini) Key (used for menu optimization, smart dish descriptions, and fallback reasoning)
GOOGLE_GENERATIVE_AI_API_KEY=

# Cloud File Storage (AWS S3)
# Leave empty in local development to automatically use built-in safe local fallback storage
AWS_REGION=us-east-1
AWS_S3_BUCKET=food-ordering-platform-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Puppeteer Configuration (Browser Automation & PDF Receipt Generator)
# In development/sandbox environments, Puppeteer uses system or bundled Chromium
PUPPETEER_EXECUTABLE_PATH=

