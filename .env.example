# ==============================================================================
# Environment Configuration — Food Ordering Platform (Cd: Zaika) — Django & Python
# ==============================================================================

# Django Configuration
DJANGO_SECRET_KEY=django-insecure-zaika-campus-platform-2026-super-secret-key-replace-in-prod
DJANGO_DEBUG=True

# Database Configuration (SQLite default; zero setup needed)
# SQLite file: db.sqlite3

# Artificial Intelligence Integrations
# OpenAI API Key (used for conversational discovery, smart dietary advisor, and recommendations)
OPENAI_API_KEY=

# Google Generative AI (Gemini) Key (used for menu optimization, smart dish descriptions, and fallback reasoning)
GOOGLE_GENERATIVE_AI_API_KEY=

# Cloud File Storage (AWS S3)
# Leave empty in local development to automatically use built-in safe local media storage
AWS_REGION=us-east-1
AWS_S3_BUCKET=food-ordering-platform-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
